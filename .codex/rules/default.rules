prefix_rule(
    pattern = ["git", ["status", "log", "diff", "show", "branch"]],
    decision = "allow",
    justification = "Read-only git operations",
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging explicit files is allowed",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Confirm before creating a commit",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Confirm before affecting a remote repository",
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force push is destructive",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset is destructive",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletion is too dangerous",
)

prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "Ripgrep is the primary read and consistency-check tool",
)

prefix_rule(
    pattern = ["find"],
    decision = "allow",
    justification = "Directory and file structure inspection is allowed",
)

prefix_rule(
    pattern = ["sed"],
    decision = "allow",
    justification = "Targeted file reads are allowed",
)

prefix_rule(
    pattern = ["wc"],
    decision = "allow",
    justification = "Line-count and size checks are allowed",
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "Directory listing is allowed",
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "Direct file reads are allowed",
)

prefix_rule(
    pattern = ["head"],
    decision = "allow",
    justification = "Direct file reads are allowed",
)

prefix_rule(
    pattern = ["tail"],
    decision = "allow",
    justification = "Direct file reads are allowed",
)
