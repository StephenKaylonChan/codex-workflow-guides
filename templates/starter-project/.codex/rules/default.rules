prefix_rule(
    pattern = ["git", ["status", "log", "diff", "show", "branch"]],
    decision = "allow",
    justification = "Read-only git operations",
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Staging explicit files is allowed",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Confirm before creating a commit",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Confirm before affecting a remote repository",
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force push is destructive",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset is destructive",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletion is too dangerous",
)

prefix_rule(
    pattern = ["pnpm", ["test", "lint", "build"]],
    decision = "allow",
    justification = "Project verification commands are allowed",
)

